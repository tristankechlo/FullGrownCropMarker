{
    "schemaVersion": 1,
    "id": "crop_marker",
    "version": "${version}",
    "name": "FullGrownCropMarker",
    "description": "Adds a little marker over all crops that are at their maximum age!",
    "authors": [
        "Buecher_wurm"
    ],
    "contact": {
        "sources": "https://github.com/tristankechlo/FullGrownCropMarker",
        "issues": "https://github.com/tristankechlo/FullGrownCropMarker/issues"
    },
    "license": "CC BY-NC-ND 4.0",
    "icon": "pack.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.tristankechlo.crop_marker.FabricFullGrownCropMarker"
        ]
    },
    "mixins": [
        {
            "config": "crop_marker.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_min}",
        "fabric-api": "*",
        "minecraft": ">=${fabric_range_min_inclusive} <${fabric_range_max_exclusive}",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/bhUaWhq",
                "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/full-grown-crop-marker",
                "modmenu.modrinth": "https://modrinth.com/mod/full-grown-crop-marker",
                "modmenu.wiki": "https://github.com/tristankechlo/FullGrownCropMarker/wiki"
            }
        }
    }
}
